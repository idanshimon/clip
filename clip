#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

show_help() {
  echo "clip v${VERSION} - Copy file contents to clipboard"
  echo ""
  echo "Usage: clip <file>"
  echo ""
  echo "Options:"
  echo "  -h, --help      Show this help message"
  echo "  -v, --version   Show version"
}

if [ $# -eq 0 ]; then
  show_help >&2
  exit 1
fi

case "$1" in
  -h|--help)    show_help; exit 0 ;;
  -v|--version) echo "clip v${VERSION}"; exit 0 ;;
esac

if [ ! -f "$1" ]; then
  echo "Error: '$1' is not a file" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin*)  cat "$1" | pbcopy ;;
  Linux*)   cat "$1" | xclip -selection clipboard 2>/dev/null \
            || cat "$1" | xsel --clipboard 2>/dev/null \
            || { echo "Error: Install xclip or xsel (e.g. sudo apt install xclip)" >&2; exit 1; } ;;
  *)        echo "Error: Unsupported OS '$(uname -s)'" >&2; exit 1 ;;
esac

lines=$(wc -l < "$1" | tr -d ' ')
echo "✓ Copied ${lines} lines from '$1' to clipboard"
