#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"

show_help() {
  echo "clip v${VERSION} - Copy file contents to clipboard"
  echo ""
  echo "Usage: clip <file|folder>"
  echo ""
  echo "If a folder is given, copies the last modified file in it."
  echo ""
  echo "Options:"
  echo "  -h, --help      Show this help message"
  echo "  -v, --version   Show version"
}

if [ $# -eq 0 ]; then
  show_help >&2
  exit 1
fi

case "$1" in
  -h|--help)    show_help; exit 0 ;;
  -v|--version) echo "clip v${VERSION}"; exit 0 ;;
esac

TARGET="$1"

if [ -d "$TARGET" ]; then
  case "$(uname -s)" in
    Darwin*)  TARGET=$(ls -t "$TARGET"/* 2>/dev/null | head -1) ;;
    *)        TARGET=$(ls -t "$TARGET"/* 2>/dev/null | head -1) ;;
  esac
  if [ -z "$TARGET" ] || [ ! -f "$TARGET" ]; then
    echo "Error: No files found in '$1'" >&2
    exit 1
  fi
  echo "→ Selected last modified file: ${TARGET}"
elif [ ! -f "$TARGET" ]; then
  echo "Error: '$1' is not a file or folder" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin*)  cat "$TARGET" | pbcopy ;;
  Linux*)   cat "$TARGET" | xclip -selection clipboard 2>/dev/null \
            || cat "$TARGET" | xsel --clipboard 2>/dev/null \
            || { echo "Error: Install xclip or xsel (e.g. sudo apt install xclip)" >&2; exit 1; } ;;
  *)        echo "Error: Unsupported OS '$(uname -s)'" >&2; exit 1 ;;
esac

lines=$(wc -l < "$TARGET" | tr -d ' ')
echo "✓ Copied ${lines} lines from '${TARGET}' to clipboard"
